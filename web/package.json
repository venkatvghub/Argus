{
  "name": "argus-root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "description": "Root workspace configuration for argus monorepo",
  "scripts": {
    "dev": "pnpm --filter argus-web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "type-check": "pnpm -r --if-present type-check",
    "test": "pnpm -r --if-present test"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
