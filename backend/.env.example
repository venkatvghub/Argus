# Argus Backend Configuration
# Copy this file to .env and fill in your values
# Configuration uses environment variables with prefix REPOWISE_

# --- Application ---
# REPOWISE_APP_NAME=argus
# REPOWISE_ENV=development

# --- Logging ---
# REPOWISE_LOG_LEVEL=info
# Valid values: debug, info, warn, error

# --- Persistence ---
# REPOWISE_DB_PATH=data/argus.db
# Path to SQLite database file (relative or absolute)

# REPOWISE_DATA_DIR=data
# Directory for externalized state (graph exports, caches)

# REPOWISE_DOCS_DIR=docs
# Directory for generated documentation and analysis results

# --- LLM Provider (choose one: openai | anthropic | gemini)---
REPOWISE_LLM_PROVIDER=openai

# --- API Keys (set the one matching your provider) ---
# OpenAI
REPOWISE_OPENAI_API_KEY=sk-proj-

# Anthropic
# REPOWISE_ANTHROPIC_API_KEY=sk-ant-

# Google Gemini
# REPOWISE_GEMINI_API_KEY=

# --- Model Names (defaults shown; adjust per provider) ---
# OpenAI models
REPOWISE_OPENAI_MODEL=gpt-4o-mini

# Anthropic models
REPOWISE_ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Google Gemini models
REPOWISE_GEMINI_MODEL=gemini-2.0-flash

# --- Compliance Patterns ---
# Comma-separated list of PII/sensitive patterns to detect
# Standard patterns: AADHAAR, PAN, UPI_ID, MOBILE, EMAIL
REPOWISE_PII_PATTERNS=AADHAAR,PAN,UPI_ID,MOBILE,EMAIL

# --- Cognee Integration (optional) ---
# REPOWISE_COGNEE_WEBHOOK_URL=http://localhost:8090/api/export/cognee
# Webhook endpoint for exporting analysis results to Cognee

# --- Server Configuration (optional) ---
# REPOWISE_PORT=8080
# Port for REST server

# REPOWISE_MCP_STDIO=false
# Set to true to enable MCP server mode (stdio transport)

# --- Performance Tuning (optional) ---
# REPOWISE_MAX_GOROUTINES=256
# Max concurrent goroutines for analysis

# REPOWISE_PARSE_TIMEOUT_SECONDS=30
# Timeout for parsing a single file

# REPOWISE_GIT_HISTORY_LIMIT=10000
# Max commits to traverse in git history
