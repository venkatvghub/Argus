# Argus Backend Configuration
# Copy this file to .env and fill in your values
# Configuration uses environment variables with prefix ARGUS_

# --- Application ---
# ARGUS_APP_NAME=argus
# ARGUS_ENV=development

# --- Logging ---
# ARGUS_LOG_LEVEL=info
# Valid values: debug, info, warn, error

# --- Persistence ---
# ARGUS_DB_PATH=argus.db
# SQLite file name or absolute path (relative paths resolve under ARGUS_DATA_DIR)

# ARGUS_DATA_DIR=data
# Directory for externalized state (SQLite DB, graph exports, caches)

# ARGUS_DOCS_DIR=docs
# Directory for generated documentation and analysis results

# --- LLM Provider (choose one: openai | anthropic | gemini)---
ARGUS_LLM_PROVIDER=openai

# --- API Keys (set the one matching your provider) ---
# OpenAI (direct)
ARGUS_OPENAI_API_KEY=sk-proj-
# ARGUS_OPENAI_BASE_URL=https://api.openai.com/v1   # default; omit for standard OpenAI

# OpenRouter (OpenAI-compatible — set base URL + key from openrouter.ai)
# ARGUS_OPENAI_API_KEY=sk-or-v1-...
# ARGUS_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Azure OpenAI (set base URL to your deployment endpoint)
# ARGUS_OPENAI_API_KEY=<azure-key>
# ARGUS_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>

# Anthropic
# ARGUS_ANTHROPIC_API_KEY=sk-ant-

# Google Gemini
# ARGUS_GEMINI_API_KEY=

# --- Chat / SSE Model (argus serve only) ---
# Used by `argus serve` for interactive chat streaming. Set the model for whichever
# provider is active (ARGUS_LLM_PROVIDER). Not used by `argus init`.
# ARGUS_OPENAI_MODEL=gpt-4o
# ARGUS_ANTHROPIC_MODEL=claude-sonnet-4-6
# ARGUS_GEMINI_MODEL=gemini-1.5-pro

# --- Wiki Generation Tier Models (argus init only) ---
# Controls which model is used per complexity tier during wiki generation.
# If unset, `argus init` fetches available models from the provider API and prompts
# you to pick interactively. Set all three to skip discovery and prompts entirely.
# ARGUS_CHEAP_MODEL=mistralai/mistral-7b-instruct   # file pages, symbol spotlights
# ARGUS_MEDIUM_MODEL=openai/gpt-4o                  # module, API contract, SCC pages
# ARGUS_PREMIUM_MODEL=anthropic/claude-opus-4        # repo overview, architecture, onboarding

# --- Compliance Patterns ---
# Comma-separated list of PII/sensitive patterns to detect
# Standard patterns: AADHAAR, PAN, UPI_ID, MOBILE, EMAIL
ARGUS_PII_PATTERNS=AADHAAR,PAN,UPI_ID,MOBILE,EMAIL

# --- Analysis thresholds ---
# ARGUS_TOKEN_BLOAT_THRESHOLD=50

# --- Job worker pool ---
# ARGUS_WORKER_COUNT=3
# ARGUS_WORK_QUEUE_SIZE=32
# ARGUS_JOB_LISTENER_BUFFER=10

# --- Stub LLM streaming (mock providers) ---
# ARGUS_MOCK_STREAM_TOKEN_DELAY_MS=50

# --- CORS (SSE endpoints) ---
# Comma-separated browser origins allowed for EventSource/chat streams
ARGUS_CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000

# --- Wiki Coverage ---
# ARGUS_COVERAGE=0.20
# Fraction of the repository to generate wiki pages for (0.10–1.0).
# 20% is recommended — picks highest-impact files by graph centrality.
# If unset, argus init shows an interactive selection table.

# --- LLM Retry & Circuit Breaker ---
# Applied per generation tier (cheap / medium / premium) in the TieredRouter.
# Set ARGUS_LLM_MAX_RETRIES=0 to disable retry entirely.
# Set ARGUS_LLM_CIRCUIT_FAILURE_THRESHOLD=0 to disable the circuit breaker.

# ARGUS_LLM_MAX_RETRIES=3
# Maximum retry attempts per LLM call (after the initial attempt). 429 and 5xx are retried;
# 400/401/403 are treated as permanent and never retried.

# ARGUS_LLM_RETRY_INITIAL_DELAY_MS=500
# First backoff interval in milliseconds (doubles on each attempt + 25% jitter).

# ARGUS_LLM_RETRY_MAX_DELAY_MS=30000
# Cap on exponential backoff (30 s). Prevents unbounded waits on persistent rate limits.

# ARGUS_LLM_RETRY_MULTIPLIER=2.0
# Growth factor for exponential backoff (1.5–3.0 are typical).

# ARGUS_LLM_CIRCUIT_FAILURE_THRESHOLD=5
# Number of consecutive failures that trip the circuit breaker for a tier.
# When the CB is open, wiki generation pauses — resume with: argus init ... --resume <job-id>

# ARGUS_LLM_CIRCUIT_RESET_TIMEOUT_S=60
# Seconds the CB waits in open state before allowing a half-open probe request.
